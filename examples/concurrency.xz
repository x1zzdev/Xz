// Structured concurrency: worker tasks communicating over typed channels.
// Deterministic: the same input produces the same output order.

record Job {
    id: Int
    payload: Str
}

record JobResult {
    id: Int
    processed: Str
}

chan work: Chan[Job]
chan done: Chan[JobResult]
chan all_done: Chan[Int]                // sentinel: one message per finished batch

/// Processes one job and sends the result.
/// @intent  Receives jobs forever, processing each and forwarding the result.
/// @effects chan
task worker {
    loop {
        let job <- recv(work)            // blocks until a job arrives
        let r = process(job)             // tasks have no error channel:
        match r {                        // errors are handled locally
            ok(res) -> send(done, res)
            err(e)  -> send(done, JobResult(job.id, "ERROR"))
        }
    }
}
}

/// Processes a single job.
/// @intent  Transforms the payload into an uppercase, quoted form.
/// @effects none
func process(job: Job) -> Result[JobResult, Err] {
    if job.payload.is_empty() {
        err(Err("empty payload"))
    } else {
        ok(JobResult(job.id, job.payload.to_upper()))
    }
}

/// Consumes results and prints them in receive order.
/// @intent  Prints each completed job until the done channel closes.
/// @effects io, chan
task reporter {
    loop {
        let r <- recv(done)             // blocks until a result arrives
        print("job " + r.id as Str + ": " + r.processed)
        send(all_done, r.id)
    }
}

func main() -> Result[Int, Err] {
    let total: Int = 5
    mut i: Int = 0
    loop {
        if i == total { break }
        send(work, Job(i, "item" + i as Str))
        i += 1
    }
    // wait for every job to be reported, then stop
    mut seen: Int = 0
    loop {
        let id <- recv(all_done)
        seen += 1
        if seen == total { break }
    }
    ok(0)
}